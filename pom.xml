<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.kingdoms</groupId>
    <artifactId>specialties</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Kingdoms-Addon-Specialties</name>
    <description>Kingdom specialties, unique resources, extractors and exclusive crafting recipes.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <!--
          The version of the server this is built for. Maven Central stops at 1.17.18.1-BETA, so a
          newer one has to be installed from the server's own plugin jar - which is also the more
          faithful thing to build against:

            mvn install:install-file -Dfile=<server>/plugins/KingdomsX-1.17.27.3.jar                 -DgroupId=com.github.cryptomorin -DartifactId=kingdoms                 -Dversion=1.17.27.3 -Dpackaging=jar

          Signatures do move between releases: 1.17.27.3 renamed KingdomItemInteractEvent to
          KingdomBuildingInteractEvent and getKingdomItem() to getBuilding(). Recompiling is how
          you find out, so bump this and build before deploying to a newer server.
        -->
        <kingdoms.version>1.17.27.3</kingdoms.version>
        <spigot.version>1.16.5-R0.1-SNAPSHOT</spigot.version>
        <!-- Must match the version KingdomsX loads into its own classloader, see the dependency below. -->
        <xseries.version>13.7.1</xseries.version>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>kingdoms</artifactId>
            <version>${kingdoms.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          XSeries: the cross-version library KingdomsX itself builds on. It downloads it, relocates
          com.cryptomorin.xseries to org.kingdoms.libs.xseries and injects it into its OWN plugin
          classloader, so an addon that depends on Kingdoms sees it at runtime.

          Hence 'provided' plus the shade relocation below: we compile against the library and let
          the relocation rewrite our references to the package KingdomsX actually loaded, without
          shipping a single class of it. Bundling our own copy would only mean two XSeries on the
          server, and the wrong one winning.
        -->
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>${xseries.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>Kingdoms-Addon-Specialties-${project.version}</finalName>
        <defaultGoal>clean package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!--
                              Rewrites this addon's own references. XSeries is 'provided', so none
                              of its classes end up in the jar: the relocation only points us at
                              the copy KingdomsX already loaded.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>com.cryptomorin.xseries</pattern>
                                    <shadedPattern>org.kingdoms.libs.xseries</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
